    {
      "name": "Flow 1 - Authentication and Profile",
      "description": "User logs in, receives a token, then uses that token to fetch their own profile. Verifies the full authentication chain end-to-end.",
      "item": [
        {
          "name": "Step 1: Login and capture token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bahadirkarakus261@gmail.com\",\n  \"password\": \"bahadir26\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "// Always capture token outside test blocks so later steps can use it",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token captured successfully');",
                  "}",
                  "",
                  "pm.test('[Flow1-Step1] Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[Flow1-Step1] Response contains a valid token', function () {",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 2: Fetch own profile using captured token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('[Flow1-Step2] Profile fetch returns 200 with valid token', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[Flow1-Step2] Profile response has user data', function () {",
                  "  // Accept any user identifier field",
                  "  const hasId = json._id || json.id || json.userId;",
                  "  pm.expect(hasId).to.exist;",
                  "  console.log('Profile fetched for user:', hasId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 3: Verify tampered token is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer tampered.invalid.token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('[Flow1-Step3] Tampered token is rejected with 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('[Flow1-Step3] Response contains an error field', function () {",
                  "  // Backend may use 'message' or 'error' — accept either",
                  "  const hasError = json.message || json.error;",
                  "  pm.expect(hasError).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
